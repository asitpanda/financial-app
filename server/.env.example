# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/myfinancial?schema=public"
DB_PROVIDER="mock"  # Options: supabase, firebase, mock

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"

# Supabase Configuration (when DB_PROVIDER=supabase)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Firebase Configuration (when DB_PROVIDER=firebase)
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_PRIVATE_KEY="your-private-key"
# FIREBASE_CLIENT_EMAIL="your-client-email"
