// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HistoricalImportMode {
  OPENING_BALANCE
  TRACK_FROM_TODAY
}

enum InvestmentEventStatus {
  EXPECTED
  PENDING
  CONFIRMED
  SKIPPED
  FAILED
  CANCELLED
}

enum InvestmentEventSource {
  MANUAL
  RECURRING_PLAN
  HISTORICAL_IMPORT
  BANK_IMPORT
  BROKER_IMPORT
  SYSTEM_GENERATED
}

enum InvestmentEventType {
  CONTRIBUTION
  OPENING_BALANCE
  OPENING_INCOME_CREDIT
  INCOME_CREDIT
  WITHDRAWAL_PRINCIPAL
  PREMIUM
}

enum InvestmentContributionMode {
  ONE_TIME
  RECURRING
}

// How a product participates in portfolio totals/gain-loss, independent of asset type/category.
enum AccountingTreatment {
  INVESTMENT
  INSURANCE_SAVINGS
  PROTECTION_EXPENSE
}

enum InvestmentBenefitType {
  MATURITY
  SURRENDER
  COUPON
  INTEREST
  PRINCIPAL_REDEMPTION
  ANNUITY
  MONEY_BACK
  SURVIVAL
  BONUS
  RETURN_OF_PREMIUM
  DEATH_BENEFIT
  OTHER
}

enum InvestmentBenefitStatus {
  EXPECTED
  RECEIVED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
}

model User {
  id        Int      @id @default(autoincrement())
  userId    String?  @unique @db.VarChar(30)
  email     String   @unique
  mobile    String?  @unique @db.VarChar(15)
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories         Category[]
  financialAccounts  FinancialAccount[]
  transactions       Transaction[]
  goals              Goal[]
  investments        Investment[]
  investmentAssetTaxonomy InvestmentAssetTaxonomy[]
  valuationSnapshots ValuationSnapshot[]

  @@map("users")
}

model Transaction {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  categoryId              Int?
  goalId                  Int?
  sourceAccountId         Int?
  destinationAccountId    Int?
  type                    TransactionType
  amount                  Float
  categoryLabelSnapshot   String?
  date                    DateTime @default(now())
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef         Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  goal                Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sourceAccount       FinancialAccount? @relation("SourceAccountTransactions", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccount  FinancialAccount? @relation("DestinationAccountTransactions", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  linkedInvestmentEvents InvestmentEvent[] @relation("InvestmentEventLinkedTransaction")

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([goalId])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transactions")
}

model Goal {
  id                    Int      @id @default(autoincrement())
  userId                Int
  categoryId            Int
  name                  String
  description           String?
  icon                  String?
  targetAmount          Float
  currentAmount         Float   @default(0)
  startDate             DateTime @default(now())
  deadline              DateTime?
  categoryLabelSnapshot String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions  Transaction[]

  @@index([userId])
  @@index([categoryId])
  @@map("goals")
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      String
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goals        Goal[]

  @@index([userId])
  @@map("categories")
}

model FinancialAccount {
  id                  Int      @id @default(autoincrement())
  userId              Int
  name                String
  displayName         String
  accountType         String
  institutionName     String?
  accountNumberMasked String?
  currency            String
  isActive            Boolean  @default(true)
  openingBalance      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTransactions             Transaction[]     @relation("SourceAccountTransactions")
  destinationTransactions        Transaction[]     @relation("DestinationAccountTransactions")
  primaryInvestments             Investment[]      @relation("PrimaryInvestmentAccount")

  @@index([userId])
  @@map("financial_accounts")
}

model AppMetaConfigRef {
  id                  Int      @id @default(autoincrement())
  module              String
  configType          String
  parentId            Int?
  code                String   @unique
  label               String
  accountingTreatment AccountingTreatment?
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parent                        AppMetaConfigRef?         @relation("AppMetaConfigTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                      AppMetaConfigRef[]        @relation("AppMetaConfigTree")
  investmentsByAssetType        Investment[]              @relation("InvestmentAssetTypeRef")
  investmentsByAssetCategory    Investment[]              @relation("InvestmentAssetCategoryRef")
  taxonomyDefaultAssetTypes     InvestmentAssetTaxonomy[] @relation("InvestmentTaxonomyDefaultAssetTypeRef")
  taxonomyDefaultAssetCategories InvestmentAssetTaxonomy[] @relation("InvestmentTaxonomyDefaultAssetCategoryRef")

  @@index([module, configType])
  @@index([parentId])
  @@map("app_meta_config_ref")
}

model Investment {
  id                  Int      @id @default(autoincrement())
  userId              Int
  accountId           Int?
  assetTaxonomyId     Int?
  assetTypeMetaId     Int
  assetCategoryMetaId Int
  name                String
  institutionName     String?
  referenceNumber     String?
  status              String
  startDate           DateTime?
  maturityDate        DateTime?
  currency            String
  totalInvested       Float    @default(0)
  currentValue        Float    @default(0)
  currentValueSource  String?
  lastValuationAt     DateTime?
  insuranceCover      Float?
  contributionMode    InvestmentContributionMode @default(ONE_TIME)
  // Per-product exception when the category default doesn't fit; resolution: override ?? assetCategoryRef.accountingTreatment
  accountingTreatmentOverride AccountingTreatment?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAccount     FinancialAccount?        @relation("PrimaryInvestmentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  assetTaxonomy      InvestmentAssetTaxonomy? @relation(fields: [assetTaxonomyId], references: [id], onDelete: SetNull)
  assetTypeRef       AppMetaConfigRef         @relation("InvestmentAssetTypeRef", fields: [assetTypeMetaId], references: [id], onDelete: Restrict)
  assetCategoryRef   AppMetaConfigRef         @relation("InvestmentAssetCategoryRef", fields: [assetCategoryMetaId], references: [id], onDelete: Restrict)
  investmentEvents   InvestmentEvent[]
  contributionPlans  InvestmentContributionPlan[]
  valuationSnapshots ValuationSnapshot[]
  benefits           InvestmentBenefit[]

  @@index([userId])
  @@index([accountId])
  @@index([assetTaxonomyId])
  @@index([assetTypeMetaId])
  @@index([assetCategoryMetaId])
  @@map("investments")
}

model InvestmentAssetTaxonomy {
  id          Int      @id @default(autoincrement())
  userId      Int
  label       String
  nodeType    String
  level       Int
  parentId    Int?
  defaultAssetTypeMetaId Int?
  defaultAssetCategoryMetaId Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      InvestmentAssetTaxonomy?  @relation("InvestmentAssetTaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    InvestmentAssetTaxonomy[] @relation("InvestmentAssetTaxonomyTree")
  defaultAssetTypeRef AppMetaConfigRef?  @relation("InvestmentTaxonomyDefaultAssetTypeRef", fields: [defaultAssetTypeMetaId], references: [id], onDelete: SetNull)
  defaultAssetCategoryRef AppMetaConfigRef? @relation("InvestmentTaxonomyDefaultAssetCategoryRef", fields: [defaultAssetCategoryMetaId], references: [id], onDelete: SetNull)
  investments Investment[]

  @@index([userId])
  @@index([parentId])
  @@index([nodeType])
  @@index([level])
  @@index([defaultAssetTypeMetaId])
  @@index([defaultAssetCategoryMetaId])
  @@map("investment_asset_taxonomy")
}

model InvestmentEvent {
  id                    Int      @id @default(autoincrement())
  investmentId          Int
  recurringPlanId       Int?
  linkedTransactionId   Int?
  linkedBenefitId       Int?
  eventType             InvestmentEventType
  dueDate               DateTime?
  status                InvestmentEventStatus @default(PENDING)
  eventSource           InvestmentEventSource @default(MANUAL)
  sequenceNumber        Int?
  eventDate             DateTime
  amount                Decimal? @db.Decimal(18, 2)
  units                 Float?
  pricePerUnit          Decimal? @db.Decimal(18, 2)
  netAmount             Decimal? @db.Decimal(18, 2)
  notes                 String?
  meta                  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  investment            Investment         @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  recurringPlan         InvestmentContributionPlan? @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)
  linkedTransaction     Transaction?       @relation("InvestmentEventLinkedTransaction", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedBenefit         InvestmentBenefit? @relation(fields: [linkedBenefitId], references: [id], onDelete: SetNull)

  @@index([investmentId])
  @@index([recurringPlanId])
  @@index([linkedBenefitId])
  @@index([dueDate])
  @@index([status])
  @@unique([linkedTransactionId])
  @@unique([recurringPlanId, dueDate, eventType])
  @@map("investment_events")
}

model InvestmentBenefit {
  id           Int      @id @default(autoincrement())
  investmentId Int
  benefitType  InvestmentBenefitType
  amount       Decimal  @db.Decimal(18, 2)
  benefitDate  DateTime
  status       InvestmentBenefitStatus @default(EXPECTED)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investment   Investment       @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  realizedEvents InvestmentEvent[]

  @@index([investmentId])
  @@index([status])
  @@index([benefitDate])
  @@map("investment_benefits")
}

model InvestmentContributionPlan {
  id                 Int      @id @default(autoincrement())
  investmentId       Int
  status             String
  amount             Decimal @db.Decimal(18, 2)
  cadenceUnit        String
  cadenceInterval    Int
  historicalImportMode HistoricalImportMode @default(TRACK_FROM_TODAY)
  anchorDate         DateTime
  lastGeneratedDueDate DateTime?
  nextDueDate        DateTime?
  endDate            DateTime?
  reminderDaysBefore Int?
  autoCreateEvent    Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  investment    Investment        @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  events        InvestmentEvent[]

  @@index([investmentId])
  @@index([status])
  @@index([nextDueDate])
  @@map("investment_contribution_plans")
}

model ValuationSnapshot {
  id           Int      @id @default(autoincrement())
  userId       Int
  investmentId Int
  snapshotDate DateTime
  marketValue  Float
  units        Float?
  price        Float?
  source       String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([investmentId])
  @@index([snapshotDate])
  @@map("valuation_snapshots")
}
