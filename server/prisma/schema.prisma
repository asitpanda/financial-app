// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HistoricalImportMode {
  OPENING_BALANCE
  TRACK_FROM_TODAY
}

enum InvestmentEventStatus {
  EXPECTED
  PENDING
  CONFIRMED
  SKIPPED
  FAILED
  CANCELLED
}

enum InvestmentEventSource {
  MANUAL
  RECURRING_PLAN
  HISTORICAL_IMPORT
  BANK_IMPORT
  BROKER_IMPORT
  SYSTEM_GENERATED
}

model User {
  id        Int      @id @default(autoincrement())
  userId    String?  @unique @db.VarChar(30)
  email     String   @unique
  mobile    String?  @unique @db.VarChar(15)
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories         Category[]
  financialAccounts  FinancialAccount[]
  transactions       Transaction[]
  goals              Goal[]
  investments        Investment[]
  investmentAssetTaxonomy InvestmentAssetTaxonomy[]
  valuationSnapshots ValuationSnapshot[]

  @@map("users")
}

model Transaction {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  categoryId              Int
  goalId                  Int?
  sourceAccountId         Int?
  destinationAccountId    Int?
  linkedInvestmentEventId Int?
  type                    String
  transactionKind         String
  amount                  Float
  categoryLabelSnapshot   String
  date                    DateTime @default(now())
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  goal                Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sourceAccount       FinancialAccount? @relation("SourceAccountTransactions", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccount  FinancialAccount? @relation("DestinationAccountTransactions", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  linkedInvestmentEvent InvestmentEvent?  @relation("TransactionLinkedInvestmentEvent", fields: [linkedInvestmentEventId], references: [id], onDelete: SetNull)
  cashLinkEvents      InvestmentEvent[]   @relation("InvestmentEventLinkedTransaction")

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([goalId])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transactions")
}

model Goal {
  id                    Int      @id @default(autoincrement())
  userId                Int
  categoryId            Int
  name                  String
  description           String?
  icon                  String?
  targetAmount          Float
  currentAmount         Float   @default(0)
  startDate             DateTime @default(now())
  deadline              DateTime?
  categoryLabelSnapshot String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions  Transaction[]

  @@index([userId])
  @@index([categoryId])
  @@map("goals")
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      String
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goals        Goal[]

  @@index([userId])
  @@map("categories")
}

model FinancialAccount {
  id                  Int      @id @default(autoincrement())
  userId              Int
  name                String
  displayName         String
  accountType         String
  institutionName     String?
  accountNumberMasked String?
  currency            String
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTransactions             Transaction[]     @relation("SourceAccountTransactions")
  destinationTransactions        Transaction[]     @relation("DestinationAccountTransactions")
  primaryInvestments             Investment[]      @relation("PrimaryInvestmentAccount")
  fundedInvestmentEvents         InvestmentEvent[] @relation("InvestmentEventSourceAccount")
  fundedContributionPlans        InvestmentContributionPlan[] @relation("InvestmentContributionPlanSourceAccount")

  @@index([userId])
  @@map("financial_accounts")
}

model Investment {
  id                  Int      @id @default(autoincrement())
  userId              Int
  accountId           Int?
  assetTaxonomyId     Int?
  name                String
  assetType           String
  assetCategory       String
  holdingMode         String?
  institutionName     String?
  referenceNumber     String?
  status              String
  startDate           DateTime?
  maturityDate        DateTime?
  currency            String
  totalInvested       Float    @default(0)
  currentValue        Float    @default(0)
  currentValueSource  String?
  lastValuationAt     DateTime?
  insuranceCover      Float?
  contributionMode    String?
  notes               String?
  documentsMeta       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAccount     FinancialAccount?        @relation("PrimaryInvestmentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  assetTaxonomy      InvestmentAssetTaxonomy? @relation(fields: [assetTaxonomyId], references: [id], onDelete: SetNull)
  investmentEvents   InvestmentEvent[]
  contributionPlans  InvestmentContributionPlan[]
  valuationSnapshots ValuationSnapshot[]

  @@index([userId])
  @@index([accountId])
  @@index([assetTaxonomyId])
  @@map("investments")
}

model InvestmentAssetTaxonomy {
  id          Int      @id @default(autoincrement())
  userId      Int
  label       String
  nodeType    String
  level       Int
  parentId    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      InvestmentAssetTaxonomy?  @relation("InvestmentAssetTaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    InvestmentAssetTaxonomy[] @relation("InvestmentAssetTaxonomyTree")
  investments Investment[]

  @@index([userId])
  @@index([parentId])
  @@index([nodeType])
  @@index([level])
  @@map("investment_asset_taxonomy")
}

model InvestmentEvent {
  id                    Int      @id @default(autoincrement())
  investmentId          Int
  recurringPlanId       Int?
  sourceAccountId       Int?
  linkedTransactionId   Int?
  eventType             String
  dueDate               DateTime?
  status                InvestmentEventStatus @default(PENDING)
  eventSource           InvestmentEventSource @default(MANUAL)
  sequenceNumber        Int?
  eventDate             DateTime
  amount                Decimal? @db.Decimal(18, 2)
  units                 Float?
  pricePerUnit          Decimal? @db.Decimal(18, 2)
  netAmount             Decimal? @db.Decimal(18, 2)
  notes                 String?
  meta                  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  investment            Investment         @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  recurringPlan         InvestmentContributionPlan? @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)
  sourceAccount         FinancialAccount?  @relation("InvestmentEventSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  linkedTransaction     Transaction?       @relation("InvestmentEventLinkedTransaction", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedFromTransactions Transaction[]     @relation("TransactionLinkedInvestmentEvent")

  @@index([investmentId])
  @@index([recurringPlanId])
  @@index([dueDate])
  @@index([status])
  @@index([sourceAccountId])
  @@unique([recurringPlanId, dueDate, eventType])
  @@map("investment_events")
}

model InvestmentContributionPlan {
  id                 Int      @id @default(autoincrement())
  investmentId       Int
  sourceAccountId    Int?
  status             String
  amount             Decimal @db.Decimal(18, 2)
  cadenceUnit        String
  cadenceInterval    Int
  historicalImportMode HistoricalImportMode @default(TRACK_FROM_TODAY)
  anchorDate         DateTime
  lastGeneratedDueDate DateTime?
  nextDueDate        DateTime?
  endDate            DateTime?
  reminderDaysBefore Int?
  autoCreateEvent    Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  investment    Investment        @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  sourceAccount FinancialAccount? @relation("InvestmentContributionPlanSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  events        InvestmentEvent[]

  @@index([investmentId])
  @@index([sourceAccountId])
  @@index([status])
  @@index([nextDueDate])
  @@map("investment_contribution_plans")
}

model ValuationSnapshot {
  id           Int      @id @default(autoincrement())
  userId       Int
  investmentId Int
  snapshotDate DateTime
  marketValue  Float
  units        Float?
  price        Float?
  source       String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([investmentId])
  @@index([snapshotDate])
  @@map("valuation_snapshots")
}
